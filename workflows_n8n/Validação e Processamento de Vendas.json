{
  "name": "Validação e Processamento de Vendas",
  "nodes": [
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "pythonNative",
        "pythonCode": "# =========================\n# CONFIGURAÇÕES / DOMÍNIOS\n# =========================\n\ncampos_obrigatorios = [\n    \"id_pedido\",\n    \"data_venda\",\n    \"id_cliente\",\n    \"id_produto\",\n    \"nome_produto\",\n    \"categoria\",\n    \"regiao\",\n    \"estado\",\n    \"quantidade\",\n    \"preco_unitario\",\n    \"custo_unitario\",\n    \"desconto_pct\",\n    \"canal_venda\",\n    \"criado_em\",\n]\n\ncanais_validos = [\n    \"Loja Física\",\n    \"Loja Online\",\n]\n\n# Catálogo controlado\ncatalogo = {\n    \"PROD-001\": {\n        \"nome\": \"Processador de seis núcleos\",\n        \"categoria\": \"Hardware\",\n    },\n    \"PROD-002\": {\n        \"nome\": \"Placa de vídeo de 8 GB\",\n        \"categoria\": \"Hardware\",\n    },\n    \"PROD-003\": {\n        \"nome\": \"Placa-mãe\",\n        \"categoria\": \"Hardware\",\n    },\n    \"PROD-004\": {\n        \"nome\": \"Memória RAM de 16 GB\",\n        \"categoria\": \"Hardware\",\n    },\n    \"PROD-005\": {\n        \"nome\": \"Unidade de armazenamento de 1 TB\",\n        \"categoria\": \"Hardware\",\n    },\n\n    \"PROD-006\": {\n        \"nome\": \"Monitor de 24 polegadas\",\n        \"categoria\": \"Eletrônicos\",\n    },\n    \"PROD-007\": {\n        \"nome\": \"Impressora multifuncional\",\n        \"categoria\": \"Eletrônicos\",\n    },\n    \"PROD-008\": {\n        \"nome\": \"Roteador sem fio\",\n        \"categoria\": \"Eletrônicos\",\n    },\n    \"PROD-009\": {\n        \"nome\": \"Caixa de som portátil\",\n        \"categoria\": \"Eletrônicos\",\n    },\n    \"PROD-010\": {\n        \"nome\": \"Câmera de vídeo para computador\",\n        \"categoria\": \"Eletrônicos\",\n    },\n\n    \"PROD-011\": {\n        \"nome\": \"Mouse sem fio\",\n        \"categoria\": \"Acessórios\",\n    },\n    \"PROD-012\": {\n        \"nome\": \"Teclado com fio\",\n        \"categoria\": \"Acessórios\",\n    },\n    \"PROD-013\": {\n        \"nome\": \"Fone de ouvido com microfone\",\n        \"categoria\": \"Acessórios\",\n    },\n    \"PROD-014\": {\n        \"nome\": \"Cabo de vídeo de 2 metros\",\n        \"categoria\": \"Acessórios\",\n    },\n    \"PROD-015\": {\n        \"nome\": \"Suporte para computador portátil\",\n        \"categoria\": \"Acessórios\",\n    },\n}\n\nregioes_por_estado = {\n    # Norte\n    \"AC\": \"Norte\",\n    \"AP\": \"Norte\",\n    \"AM\": \"Norte\",\n    \"PA\": \"Norte\",\n    \"RO\": \"Norte\",\n    \"RR\": \"Norte\",\n    \"TO\": \"Norte\",\n\n    # Nordeste\n    \"AL\": \"Nordeste\",\n    \"BA\": \"Nordeste\",\n    \"CE\": \"Nordeste\",\n    \"MA\": \"Nordeste\",\n    \"PB\": \"Nordeste\",\n    \"PE\": \"Nordeste\",\n    \"PI\": \"Nordeste\",\n    \"RN\": \"Nordeste\",\n    \"SE\": \"Nordeste\",\n\n    # Centro-Oeste\n    \"DF\": \"Centro-Oeste\",\n    \"GO\": \"Centro-Oeste\",\n    \"MT\": \"Centro-Oeste\",\n    \"MS\": \"Centro-Oeste\",\n\n    # Sudeste\n    \"ES\": \"Sudeste\",\n    \"MG\": \"Sudeste\",\n    \"RJ\": \"Sudeste\",\n    \"SP\": \"Sudeste\",\n\n    # Sul\n    \"PR\": \"Sul\",\n    \"RS\": \"Sul\",\n    \"SC\": \"Sul\",\n}\n\n\n# =========================\n# REGISTRO RECEBIDO DO N8N\n# =========================\n\ndados = _item[\"json\"]\n\nerros = []\n\n\n# =========================\n# FUNÇÕES AUXILIARES\n# =========================\n\ndef esta_vazio(valor):\n    \"\"\"\n    Considera vazio:\n    - None\n    - string vazia\n    - string só com espaços\n    \"\"\"\n    return valor is None or (\n        isinstance(valor, str) and valor.strip() == \"\"\n    )\n\n\ndef converter_numero(valor):\n    \"\"\"\n    Tenta converter o valor para float.\n    Retorna None se não for possível.\n    \"\"\"\n    if esta_vazio(valor):\n        return None\n\n    try:\n        if isinstance(valor, str):\n            valor = valor.replace(\",\", \".\")\n\n        return float(valor)\n\n    except (ValueError, TypeError):\n        return None\n\n\n# =========================\n# 1. COMPLETUDE\n# =========================\n\nfor campo in campos_obrigatorios:\n    if campo not in dados or esta_vazio(dados.get(campo)):\n        erros.append(\n            f\"Campo obrigatório não preenchido: {campo}\"\n        )\n\n\n# =========================\n# 2. TIPOS / FORMATOS\n# =========================\n\nquantidade = converter_numero(dados.get(\"quantidade\"))\npreco_unitario = converter_numero(dados.get(\"preco_unitario\"))\ncusto_unitario = converter_numero(dados.get(\"custo_unitario\"))\ndesconto_pct = converter_numero(dados.get(\"desconto_pct\"))\n\n\n# Quantidade\nif not esta_vazio(dados.get(\"quantidade\")):\n\n    if quantidade is None:\n        erros.append(\n            \"Quantidade deve ser um valor numérico\"\n        )\n\n    elif not quantidade.is_integer():\n        erros.append(\n            \"Quantidade deve ser um número inteiro\"\n        )\n\n\n# Preço unitário\nif not esta_vazio(dados.get(\"preco_unitario\")):\n\n    if preco_unitario is None:\n        erros.append(\n            \"Preço unitário deve ser um valor numérico\"\n        )\n\n\n# Custo unitário\nif not esta_vazio(dados.get(\"custo_unitario\")):\n\n    if custo_unitario is None:\n        erros.append(\n            \"Custo unitário deve ser um valor numérico\"\n        )\n\n\n# Desconto\nif not esta_vazio(dados.get(\"desconto_pct\")):\n\n    if desconto_pct is None:\n        erros.append(\n            \"Desconto deve ser um valor numérico\"\n        )\n\n\n# =========================\n# 3. INTERVALOS\n# =========================\n\nif quantidade is not None:\n    if quantidade <= 0:\n        erros.append(\n            \"Quantidade deve ser maior que zero\"\n        )\n\n\nif preco_unitario is not None:\n    if preco_unitario <= 0:\n        erros.append(\n            \"Preço unitário deve ser maior que zero\"\n        )\n\n\nif custo_unitario is not None:\n    if custo_unitario < 0:\n        erros.append(\n            \"Custo unitário não pode ser negativo\"\n        )\n\n\nif desconto_pct is not None:\n    if desconto_pct < 0 or desconto_pct > 1:\n        erros.append(\n            \"Desconto deve estar entre 0 e 1\"\n        )\n\n\n# =========================\n# 4. CANAL DE VENDA\n# =========================\n\ncanal = dados.get(\"canal_venda\")\n\nif not esta_vazio(canal):\n\n    if canal not in canais_validos:\n        erros.append(\n            f\"Canal de venda inválido: {canal}\"\n        )\n\n\n# =========================\n# 5. ESTADO X REGIÃO\n# =========================\n\nestado = dados.get(\"estado\")\nregiao = dados.get(\"regiao\")\n\nif not esta_vazio(estado):\n\n    estado = str(estado).strip().upper()\n\n    if estado not in regioes_por_estado:\n\n        erros.append(\n            f\"Estado inválido ou não reconhecido: {estado}\"\n        )\n\n    elif not esta_vazio(regiao):\n\n        regiao_esperada = regioes_por_estado[estado]\n\n        if regiao != regiao_esperada:\n            erros.append(\n                f\"Região incompatível com o estado: \"\n                f\"{estado} pertence à região {regiao_esperada}\"\n            )\n\n\n# =========================\n# 6. PRODUTO / CATEGORIA\n# =========================\n\nid_produto = dados.get(\"id_produto\")\nnome_produto = dados.get(\"nome_produto\")\ncategoria = dados.get(\"categoria\")\n\nif not esta_vazio(id_produto):\n\n    if id_produto not in catalogo:\n\n        erros.append(\n            f\"ID de produto não encontrado no catálogo: {id_produto}\"\n        )\n\n    else:\n\n        produto_esperado = catalogo[id_produto]\n\n        nome_esperado = produto_esperado[\"nome\"]\n        categoria_esperada = produto_esperado[\"categoria\"]\n\n        # Nome do produto\n        if not esta_vazio(nome_produto):\n\n            if nome_produto != nome_esperado:\n                erros.append(\n                    f\"Nome do produto incompatível com o ID \"\n                    f\"{id_produto}. Esperado: {nome_esperado}\"\n                )\n\n        # Categoria\n        if not esta_vazio(categoria):\n\n            if categoria != categoria_esperada:\n                erros.append(\n                    f\"Categoria incompatível com o produto \"\n                    f\"{id_produto}. Esperada: {categoria_esperada}\"\n                )\n\n\n# =========================\n# 7. RESULTADO FINAL\n# =========================\n\ndados[\"registro_valido\"] = len(erros) == 0\ndados[\"motivos_erro\"] = erros\n\nreturn _item"
      },

    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "pythonNative",
        "pythonCode": "dados = _item[\"json\"]\n\nquantidade = float(dados[\"quantidade\"])\npreco_unitario = float(dados[\"preco_unitario\"])\ncusto_unitario = float(dados[\"custo_unitario\"])\ndesconto_pct = float(dados[\"desconto_pct\"])\n\nreceita_bruta = quantidade * preco_unitario\n\nvalor_desconto = receita_bruta * desconto_pct\n\nreceita_liquida = receita_bruta - valor_desconto\n\ncusto_total = quantidade * custo_unitario\n\nlucro = receita_liquida - custo_total\n\nif receita_liquida != 0:\n    margem_pct = lucro / receita_liquida\nelse:\n    margem_pct = 0\n\ndados[\"receita_bruta\"] = round(receita_bruta, 2)\ndados[\"valor_desconto\"] = round(valor_desconto, 2)\ndados[\"receita_liquida\"] = round(receita_liquida, 2)\ndados[\"custo_total\"] = round(custo_total, 2)\ndados[\"lucro\"] = round(lucro, 2)\ndados[\"margem_pct\"] = round(margem_pct, 4)\n\n\ndados.pop(\"registro_valido\", None)\ndados.pop(\"motivos_erro\", None)\n\nreturn _item"
      },

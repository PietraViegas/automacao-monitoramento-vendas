{
  "name": "Monitoramento de Alertas de Negócio",
  "nodes": [
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "pythonNative",
        "pythonCode": "dados = _item[\"json\"]\n\nalertas = []\n\n# Converte os campos para número\nlucro = float(dados[\"lucro\"])\nmargem_pct = float(dados[\"margem_pct\"])\ndesconto_pct = float(dados[\"desconto_pct\"])\n\n\n# =========================\n# 1. VENDA COM PREJUÍZO\n# =========================\n\nif lucro < 0:\n    alertas.append(\"Venda com prejuízo\")\n\n\n# =========================\n# 2. MARGEM BAIXA\n# =========================\n\nif margem_pct >= 0 and margem_pct < 0.10:\n    alertas.append(\"Margem de lucro abaixo de 10%\")\n\n\n# =========================\n# 3. DESCONTO ELEVADO\n# =========================\n\nif desconto_pct >= 0.30:\n    alertas.append(\"Desconto igual ou superior a 30%\")\n\n\n# =========================\n# RESULTADO\n# =========================\n\ndados[\"tem_alerta\"] = len(alertas) > 0\ndados[\"alertas\"] = alertas\n\nreturn _item"
      },
